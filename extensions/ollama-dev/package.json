{
	"name": "ollama-dev",
	"displayName": "%extension.displayName%",
	"description": "%extension.description%",
	"version": "0.0.1",
	"publisher": "vscode",
	"license": "MIT",
	"private": true,
	"engines": {
		"vscode": "^1.100.0"
	},
	"enabledApiProposals": [
		"chatProvider",
		"languageModelThinkingPart"
	],
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./out/extension.js",
	"contributes": {
		"languageModels": [
			{
				"vendor": "ollama"
			}
		],
		"commands": [
			{
				"command": "ollamaDev.connect",
				"title": "%command.connect.title%"
			},
			{
				"command": "ollamaDev.disconnect",
				"title": "%command.disconnect.title%"
			},
			{
				"command": "ollamaDev.reconnect",
				"title": "%command.reconnect.title%"
			},
			{
				"command": "ollamaDev.changeHost",
				"title": "%command.changeHost.title%"
			},
			{
				"command": "ollamaDev.toggleConnectionMode",
				"title": "%command.toggleConnectionMode.title%"
			}
		],
		"configuration": {
			"title": "%configuration.title%",
			"properties": {
				"ollamaDev.connectionMode": {
					"type": "string",
					"enum": ["ssh", "local"],
					"default": "ssh",
					"description": "%configuration.connectionMode.description%"
				},
				"ollamaDev.localEndpoint": {
					"type": "string",
					"default": "http://127.0.0.1:11434",
					"description": "%configuration.localEndpoint.description%"
				},
				"ollamaDev.remoteHost": {
					"type": "string",
					"default": "",
					"description": "%configuration.remoteHost.description%"
				},
				"ollamaDev.remotePort": {
					"type": "number",
					"default": 11434,
					"description": "%configuration.remotePort.description%"
				},
				"ollamaDev.localPort": {
					"type": "number",
					"default": 43134,
					"description": "%configuration.localPort.description%"
				},
				"ollamaDev.sshKeyPath": {
					"type": "string",
					"default": "",
					"description": "%configuration.sshKeyPath.description%"
				},
				"ollamaDev.inferenceParams": {
					"type": "object",
					"default": {},
					"description": "%configuration.inferenceParams.description%"
				}
			}
		}
	},
	"scripts": {
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./"
	}
}
