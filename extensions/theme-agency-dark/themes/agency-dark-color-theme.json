	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#6B6860"
			}
		},
		{
			"scope": [
				"string",
				"meta.embedded.assembly"
			],
			"settings": {
				"foreground": "#E2C97E"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"support.constant"
			],
			"settings": {
				"foreground": "#4F8EC4"
			}
		},
		{
			"scope": [
				"keyword",
				"storage",
				"storage.type"
			],
			"settings": {
				"foreground": "#9B8FD4"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call",
				"variable.function"
			],
			"settings": {
				"foreground": "#E2C97E"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"support.type",
				"entity.name.class",
				"entity.name.namespace"
			],
			"settings": {
				"foreground": "#C9A84C"
			}
		},
		{
			"scope": [
				"variable",
				"meta.definition.variable.name",
				"meta.object-literal.key"
			],
			"settings": {
				"foreground": "#EEE8D8"
			}
		},
		{
			"scope": [
				"variable.parameter"
			],
			"settings": {
				"foreground": "#A8A59E"
			}
		},
		{
			"scope": [
				"variable.other.constant",
				"variable.other.enummember",
				"constant.other"
			],
			"settings": {
				"foreground": "#D98A3A"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"support.class.component"
			],
			"settings": {
				"foreground": "#4F8EC4"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name",
				"entity.name.attribute"
			],
			"settings": {
				"foreground": "#C9A84C"
			}
		},
		{
			"scope": [
				"punctuation",
				"meta.brace",
				"meta.delimiter"
			],
			"settings": {
				"foreground": "#A8A59E"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#EEE8D8",
				"background": "#E05C5C"
			}
		}
	],
	"semanticTokenColors": {
		"namespace": "#C9A84C",
		"class": "#C9A84C",
		"type": "#C9A84C",
		"typeParameter": "#C9A84C",
		"enum": "#D98A3A",
		"interface": "#4F8EC4",
		"struct": "#4F8EC4",
		"parameter": "#A8A59E",
		"variable": "#EEE8D8",
		"property": "#EEE8D8",
		"enumMember": "#D98A3A",
		"function": "#E2C97E",
		"method": "#E2C97E",
		"macro": "#D98A3A",
		"keyword": "#9B8FD4",
		"string": "#E2C97E",
		"number": "#4F8EC4",
		"regexp": "#D98A3A",
		"comment": "#6B6860",
		"operator": "#A8A59E"
	}
}
