{
  "name": "simple-browser",
  "displayName": "%displayName%",
  "description": "%description%",
  "enabledApiProposals": [
    "externalUriOpener"
  ],
  "version": "10.0.0",
  "icon": "media/icon.png",
  "publisher": "vscode",
  "license": "MIT",
  "aiKey": "0c6ae279ed8443289764825290e4f9e2-1a736e7c-1324-4338-be46-fc2a58ae4d14-7255",
  "engines": {
    "vscode": "^1.70.0"
  },
  "main": "./out/extension",
  "browser": "./dist/browser/extension",
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onCommand:simpleBrowser.api.open",
    "onOpenExternalUri:http",
    "onOpenExternalUri:https",
    "onWebviewPanel:simpleBrowser.view"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "simpleBrowser.show",
        "title": "Show",
        "category": "Simple Browser"
      },
      {
        "command": "simpleBrowser.screenshotPage",
        "title": "%command.screenshotPage%",
        "category": "Simple Browser",
        "icon": "$(device-camera)"
      },
      {
        "command": "simpleBrowser.screenshotEditor",
        "title": "%command.screenshotEditor%",
        "category": "Simple Browser",
        "icon": "$(window)"
      },
      {
        "command": "simpleBrowser.zoomIn",
        "title": "%command.zoomIn%",
        "category": "Simple Browser",
        "icon": "$(zoom-in)"
      },
      {
        "command": "simpleBrowser.zoomOut",
        "title": "%command.zoomOut%",
        "category": "Simple Browser",
        "icon": "$(zoom-out)"
      },
      {
        "command": "simpleBrowser.zoomReset",
        "title": "%command.zoomReset%",
        "category": "Simple Browser",
        "icon": "$(screen-normal)"
      },
      {
        "command": "simpleBrowser.printPage",
        "title": "%command.printPage%",
        "category": "Simple Browser",
        "icon": "$(output)"
      },
      {
        "command": "simpleBrowser.toggleDevTools",
        "title": "%command.toggleDevTools%",
        "category": "Simple Browser",
        "icon": "$(tools)"
      },
      {
        "command": "simpleBrowser.pageSearch",
        "title": "%command.pageSearch%",
        "category": "Simple Browser",
        "icon": "$(search)"
      },
      {
        "command": "simpleBrowser.captureConsole",
        "title": "%command.captureConsole%",
        "category": "Simple Browser",
        "icon": "$(terminal)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "simpleBrowser.zoomIn",
          "when": "activeWebviewPanelId == 'simpleBrowser.view'",
          "group": "navigation@1"
        },
        {
          "command": "simpleBrowser.zoomOut",
          "when": "activeWebviewPanelId == 'simpleBrowser.view'",
          "group": "navigation@2"
        },
        {
          "command": "simpleBrowser.zoomReset",
          "when": "activeWebviewPanelId == 'simpleBrowser.view'",
          "group": "navigation@3"
        },
        {
          "command": "simpleBrowser.pageSearch",
          "when": "activeWebviewPanelId == 'simpleBrowser.view'",
          "group": "navigation@4"
        },
        {
          "command": "simpleBrowser.screenshotPage",
          "when": "activeWebviewPanelId == 'simpleBrowser.view'",
          "group": "navigation@5"
        },
        {
          "command": "simpleBrowser.screenshotEditor",
          "when": "activeWebviewPanelId == 'simpleBrowser.view'",
          "group": "navigation@6"
        },
        {
          "command": "simpleBrowser.printPage",
          "when": "activeWebviewPanelId == 'simpleBrowser.view'",
          "group": "navigation@7"
        },
        {
          "command": "simpleBrowser.toggleDevTools",
          "when": "activeWebviewPanelId == 'simpleBrowser.view'",
          "group": "navigation@7"
        },
        {
          "command": "simpleBrowser.captureConsole",
          "when": "activeWebviewPanelId == 'simpleBrowser.view'",
          "group": "navigation@8"
        }
      ],
      "commandPalette": [
        {
          "command": "simpleBrowser.show",
          "when": "isWeb"
        }
      ]
    },
    "configuration": [
      {
        "title": "Simple Browser",
        "properties": {
          "simpleBrowser.focusLockIndicator.enabled": {
            "type": "boolean",
            "default": true,
            "title": "Focus Lock Indicator Enabled",
            "description": "%configuration.focusLockIndicator.enabled.description%"
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "gulp compile-extension:simple-browser && npm run build-webview",
    "watch": "npm run build-webview && gulp watch-extension:simple-browser",
    "vscode:prepublish": "npm run build-ext && npm run build-webview",
    "build-ext": "node ../../node_modules/gulp/bin/gulp.js --gulpfile ../../build/gulpfile.extensions.mjs compile-extension:simple-browser ./tsconfig.json",
    "build-webview": "node ./esbuild.webview.mts",
    "compile-web": "npm-run-all2 -lp bundle-web typecheck-web",
    "bundle-web": "node ./esbuild.browser.mts",
    "typecheck-web": "tsgo --project ./tsconfig.json --noEmit",
    "watch-web": "npm-run-all2 -lp watch-bundle-web watch-typecheck-web",
    "watch-bundle-web": "node ./esbuild.browser.mts --watch",
    "watch-typecheck-web": "tsgo --project ./tsconfig.json --noEmit --watch"
  },
  "dependencies": {
    "@vscode/extension-telemetry": "^0.9.8"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "@types/vscode-webview": "^1.57.0",
    "@vscode/codicons": "^0.0.36"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/microsoft/vscode.git"
  }
}
